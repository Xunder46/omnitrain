# Settings for the crew runner (.claude/scripts/macos/crew-run.sh). Committed; no secrets.
# The crew is the governor's own team (see .claude/crew.md). It shares nothing with .claude/pipeline.env:
# change a value here, never there. An environment variable of the same name overrides a value here.

# Provider: OpenCode Go through the local header proxy (with-opencode.sh). The key is
# COPILOT_PROVIDER_API_KEY from the environment; the runner sets the base URL and the model ids itself.
COPILOT_WRAPPER="with-opencode.sh"
COPILOT_BIN=copilot
COPILOT_NO_CUSTOM_INSTRUCTIONS=1
COPILOT_REASONING_EFFORT=

# Models: only these two are used. Per agent, so each can be moved by one line when friction.md shows
# a model failing its job. deepseek = proven here for building; glm = a second model family for
# the roles that check someone else's work (a checker that shares the builder's blind spots checks nothing).
DEEPSEEK=deepseek-v4.1-flash
GLM=glm-5.3-flash
CREW_MODEL_crew_scout="$GLM"
# glm since 2026-10-13: deepseek architects died twice on the provider's "reasoning_content" 400 (19f);
# glm wrote 19f and 23e1 with the seed intact and no failure (deepseek: 4 good runs, 2 provider deaths).
CREW_MODEL_crew_architect="$GLM"
CREW_MODEL_crew_builder_data="$DEEPSEEK"
CREW_MODEL_crew_builder_app="$DEEPSEEK"
CREW_MODEL_crew_builder_watch="$DEEPSEEK"
CREW_MODEL_crew_prover="$GLM"
CREW_MODEL_crew_reviewer="$GLM"
CREW_MODEL_crew_docs_keeper="$GLM"

# Time and loop limits (0 = off). Same meanings as in the shared runner.
WAIT_MINUTES=25
POLL_SECONDS=15
TAIL_LINES=40
MAX_RUN_MINUTES=90
STALL_MINUTES=20
REPEAT_STOP=40
# Earlier stops, measured on 363 runs (2026-10-13). Healthy runs: at most 10 denied calls; checkers
# (scout, architect, reviewer) at most 20 repeats of one command, scout/reviewer at most 13 reads of one
# file. The loops they would have cut: 43 denied python calls, 40-50 identical git-diffs, 73 reads.
# Builders keep REPEAT_STOP: they re-run one test 15-23 times and edit one file up to 40 times legitimately.
DENIED_STOP=12
CHECKER_REPEAT_STOP=25
CHECKER_READ_STOP=25
NO_WRITE_STOP=15
LONG_RUN_MINUTES=25
HUNG_CHILD_MINUTES=10

# Parallel runs: at most this many runs that WRITE files at once, and never two whose write scopes
# overlap. Read-only runs (scout, reviewer, architect-reading) are not counted. Raise only with evidence.
MAX_PARALLEL_WRITERS=2
