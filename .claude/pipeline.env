# Runner settings for the Copilot runner (.claude/scripts/<os>/run-agent.*). Committed; no secrets.
# An environment variable of the same name overrides a value here.

# Minutes each `start`/`wait` call blocks before returning a RUNNING summary (keep under the
# Bash tool timeout in .claude/settings.json).
WAIT_MINUTES=15

# Wrapper every Copilot run goes through: "with-opencode.sh" (macOS) / "with-opencode.ps1" (Windows)
# for OpenCode Go/Zen (adds the
# headers they require through a local proxy), "" to call Copilot directly.
COPILOT_WRAPPER="with-opencode.sh"

# Automatic stops (0 = off). A run is stopped when it exceeds MAX_RUN_MINUTES; when one tool call
# repeats REPEAT_STOP times (loop), or REPEAT_STOP calls are denied (denied), or one line of prose
# repeats max(200, 5 × REPEAT_STOP) times (filler: the model has degenerated); or when both its log
# and the working-tree diff have been idle for STALL_MINUTES (stalled).
MAX_RUN_MINUTES=120
REPEAT_STOP=40
STALL_MINUTES=30

# A child process idle (~0% CPU) this long is reported as HUNG_CHILD (never killed automatically).
HUNG_CHILD_MINUTES=10

# Per-role Copilot models (empty = provider default). Planner: conductor*; reviewer: code-reviewer;
# developer: everything else. A 4th runner argument overrides one run.
PLANNER_MODEL="deepseek-v4-pro"
DEVELOPER_MODEL="deepseek-v4.1-flash"
REVIEWER_MODEL="deepseek-v4-pro"

POLL_SECONDS=15
TAIL_LINES=40
COPILOT_BIN=copilot
