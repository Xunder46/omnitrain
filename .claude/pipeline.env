# Runner settings for .claude/scripts/macos/run-agent.sh (no secrets). An environment variable of
# the same name overrides a value here for one run.
WAIT_MINUTES=15            # each start/wait call returns after this long (keep below the Bash timeout)
MAX_RUN_MINUTES=120        # hard cap per agent run
STALL_MINUTES=30           # stop when the log AND the diff are both idle this long
REPEAT_STOP=40             # stop when one agent action repeats this many times (a loop)
HUNG_CHILD_MINUTES=10      # report a child process idle at ~0% CPU this long
# No COPILOT_BASE_URL is set in the shell, so Copilot goes through the local OpenCode proxy.
COPILOT_WRAPPER=with-opencode.sh
