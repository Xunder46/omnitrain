{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "3600000",
    "BASH_MAX_TIMEOUT_MS": "3600000"
  },
  "permissions": {
    "allow": [
      "Bash(bash .claude/scripts/macos/run-agent.sh:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Edit(.work/**)",
      "Bash(bash .claude/scripts/macos/with-timeout.sh:*)",
      "Write(.work/**)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git branch:*)"
    ]
  }
}
