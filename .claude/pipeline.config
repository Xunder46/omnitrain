# Agentic pipeline configuration for OmniTrain (bundle: agentic-pipeline-bundle, see .claude/pipeline.version).
# No secrets. omnitrain's pipeline files were merged from the bundle by hand, not installed over: the
# agents carry an "OmniTrain specifics" section, the data agent is named `dba`, both planners are
# kept, and /feature keeps the develop-only, owner-commits policy. Re-running the installer with
# --force would undo those, so diff its staged output against the repo instead.

# ---- Required ------------------------------------------------------------------------------------
PROJECT_NAME="OmniTrain"
STACK="Flutter/Dart (iOS/Android, web-safe), Material 3, Hive persistence, ChangeNotifier state; watchOS client in Swift (watch/watchos)"
BASE_BRANCH="develop"
LINT_CMD="flutter analyze"
TEST_CMD="flutter test"
PLANS_ROOT="docs/plans"
CONVENTIONS_DOC="docs/global_conventions.md"
PLANNER_AGENT="conductor-v2"
PLATFORM="macos"

# ---- Layout --------------------------------------------------------------------------------------
SOURCE_ROOT="lib/"
TEST_ROOT="test/"
DOCS_ROOT="docs/"
DOCS_INDEX="docs/README.md"
DOC_STANDARD="docs/documentation_standard.md"
MODEL_DIR="lib/data/models/"
PERSISTENCE_DIR="lib/data/repositories/"
STATE_DIR="lib/state/"
UI_DIR="lib/features/"
SHARED_UI_DIR="lib/widgets/"
CORE_DIR="lib/core/"
DATA_INTERFACE="WorkoutRepository"
PRIMARY_IMPL="HiveWorkoutRepository"
TEST_IMPL="MockWorkoutRepository"
SCHEMA_ARTIFACT="scripts/sqlite_schema.sql"
SEED_FILE="lib/mock/seed_data.dart"
DESIGN_SYSTEM_DOC="docs/design_system.md"

# ---- Other commands ------------------------------------------------------------------------------
TYPECHECK_CMD=""
BUILD_CMD=""
RUN_CMD="flutter run"

# ---- Pipeline behaviour --------------------------------------------------------------------------
INVARIANT_CHECKS='`grep -rln "import .*hive_workout_repository" lib/state lib/features lib/widgets lib/core` returns nothing'
LONG_CMD_TIMEOUT=300
TEST_TIMEOUT=900
MAX_AGENT_MINUTES=90

# Stronger model where few requests decide a lot (planning, review); the fast one for implementation.
PLANNER_MODEL="deepseek-v4.1-flash"
DEVELOPER_MODEL="deepseek-v4.1-flash"
REVIEWER_MODEL="deepseek-v4.1-flash"

# swift-test lets agents compile and test the watch package themselves (they could not before, which
# cost two fix rounds on the watch bridge). build stays an agent check, not a governor verify step.
GATEWAY_EXTRA="build|900|flutter build ios --simulator --no-codesign; codegen|300|dart run build_runner build --delete-conflicting-outputs; pub-get|300|flutter pub get; format|120|dart format|requires-args new-files-only; swift-test|900|swift test --package-path watch/watchos; base-setup|300|flutter pub get --offline"

# ---- Runner (.claude/pipeline.env) ---------------------------------------------------------------
COPILOT_WRAPPER="with-opencode.sh"
WAIT_MINUTES=15
MAX_RUN_MINUTES=120
STALL_MINUTES=30
REPEAT_STOP=40
