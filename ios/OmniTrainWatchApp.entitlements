<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HealthKit capability for the watch app's workout session, which keeps the app running with the wrist down. Reference this file from the watch target's CODE_SIGN_ENTITLEMENTS build setting. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
