{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnitrain.app/watch/sync_protocol/v1/messages/routines_down.schema.json",
  "title": "routines_down",
  "description": "Phone → watch. The user's routines (full template chain) plus the fallback exercise list the watch may log without reaching the phone.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "type": { "const": "routines_down" },
        "origin": { "const": "phone" },
        "payload": {
          "type": "object",
          "required": ["generatedAt", "routines", "fallbackExercises"],
          "additionalProperties": false,
          "properties": {
            "generatedAt": {
              "$ref": "envelope.schema.json#/$defs/timestamp"
            },
            "routines": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/routine" }
            },
            "fallbackExercises": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "envelope.schema.json#/$defs/catalogExercise" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "routine": {
      "type": "object",
      "required": ["routineId", "name", "updatedAt", "segments"],
      "additionalProperties": false,
      "properties": {
        "routineId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "updatedAt": { "$ref": "envelope.schema.json#/$defs/timestamp" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/segment" }
        }
      }
    },
    "segment": {
      "type": "object",
      "required": ["segmentId", "name", "efforts"],
      "additionalProperties": false,
      "properties": {
        "segmentId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "efforts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effort" }
        }
      }
    },
    "effort": {
      "type": "object",
      "required": [
        "effortId",
        "exerciseId",
        "exerciseName",
        "effortKind",
        "capabilities",
        "targets"
      ],
      "additionalProperties": false,
      "properties": {
        "effortId": { "type": "string", "minLength": 1 },
        "exerciseId": { "type": "string", "minLength": 1 },
        "exerciseName": { "type": "string", "minLength": 1 },
        "effortKind": { "$ref": "envelope.schema.json#/$defs/effortKind" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "envelope.schema.json#/$defs/capability" }
        },
        "targets": { "$ref": "envelope.schema.json#/$defs/metricTargets" }
      }
    }
  }
}
