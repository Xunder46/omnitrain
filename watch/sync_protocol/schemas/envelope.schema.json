{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnitrain.app/watch/sync_protocol/v1/envelope.schema.json",
  "title": "SyncEnvelope",
  "description": "Fields every sync message carries, plus the payload fragments shared by more than one message type.",
  "type": "object",
  "required": ["protocolVersion", "messageId", "type", "origin", "sentAt", "payload"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "minimum": 1
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "routines_down",
        "exercise_push",
        "structure_change",
        "observations_up",
        "session_lifecycle",
        "session_snapshot",
        "timer_state"
      ]
    },
    "origin": {
      "enum": ["watch", "phone"]
    },
    "sentAt": {
      "$ref": "#/$defs/timestamp"
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "Wall-clock instant in UTC. Local counters are never part of a message."
    },
    "capability": {
      "enum": [
        "time",
        "hold",
        "reps",
        "sets",
        "load",
        "bilateral",
        "distance",
        "rounds"
      ]
    },
    "effortKind": {
      "enum": ["set", "timed", "round", "drill"]
    },
    "catalogExercise": {
      "type": "object",
      "description": "A catalog exercise: what it is, not where it sits in a session.",
      "required": ["exerciseId", "name", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "exerciseId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "sessionExercise": {
      "type": "object",
      "description": "A catalog exercise occupying a slot in the live session. sessionExerciseId names the slot — unique within the session, stable across reorder, preserved across swap — so the same exerciseId may appear in several slots.",
      "required": [
        "sessionExerciseId",
        "exerciseId",
        "name",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "sessionExerciseId": {
          "type": "string",
          "minLength": 1
        },
        "exerciseId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "metricTargets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sets": {
          "type": "integer",
          "minimum": 1
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "loadKg": {
          "type": "number",
          "minimum": 0
        },
        "holdMs": {
          "type": "integer",
          "minimum": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "distanceMeters": {
          "type": "number",
          "minimum": 0
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["entryId", "eventId", "kind", "loggedAt"],
      "additionalProperties": false,
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["set", "timed", "round", "hold", "nutrition_quick_log"]
        },
        "loggedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "sessionExerciseId": {
          "type": "string",
          "minLength": 1
        },
        "exerciseId": {
          "type": "string",
          "minLength": 1
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "loadKg": {
          "type": "number",
          "minimum": 0
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "endedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "roundNumber": {
          "type": "integer",
          "minimum": 1
        },
        "foodId": {
          "type": "string",
          "minLength": 1
        },
        "servings": {
          "type": "number",
          "minimum": 0
        },
        "calories": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "timer": {
      "type": "object",
      "required": ["kind", "state", "startedAt"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["rest", "round", "hold", "elapsed"]
        },
        "state": {
          "enum": ["running", "paused", "stopped"]
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "pausedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "stoppedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "accumulatedPauseMs": {
          "type": "integer",
          "minimum": 0
        },
        "plannedDurationMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rest": {
          "oneOf": [{ "$ref": "#/$defs/timer" }, { "type": "null" }]
        },
        "round": {
          "oneOf": [{ "$ref": "#/$defs/timer" }, { "type": "null" }]
        },
        "hold": {
          "oneOf": [{ "$ref": "#/$defs/timer" }, { "type": "null" }]
        },
        "elapsed": {
          "oneOf": [{ "$ref": "#/$defs/timer" }, { "type": "null" }]
        }
      }
    }
  }
}
