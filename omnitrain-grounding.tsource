    );

    // Day 8: 100 g pasta (catalog: 5P/25C/1F 100 g)
    rows.add(
      row(
        id: 'seed-consumed-d8-pasta',
        daysAgo: 8,
        name: 'Pasta, cooked',
        unitType: FoodUnitType.grams,
        referenceAmount: 100,
