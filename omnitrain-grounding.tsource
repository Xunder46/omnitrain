        expect(buttonRect.left, closeTo(expectedLeft, 0.5));
        expect(buttonRect.right, closeTo(expectedRight, 0.5));
        expect(
          buttonRect.height,
          closeTo(OmniTheme.buttonPrimaryHeight, 0.5),
