        groupNameSnapshot: 'Grains & Starches',
      ),
    );
    // Day 8: 100 g ground_beef (catalog: 26P/0C/15F 100 g)
    rows.add(
      row(
        id: 'seed-consumed-d8-beef',
        daysAgo: 8,
