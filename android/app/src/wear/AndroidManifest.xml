<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The wear flavor's manifest (plan 280, D-28008).

      `android.hardware.type.watch` is the whole difference between the two
      APKs: it tells Play this one belongs on a watch, and it is what makes the
      Wear OS launcher show the app. Everything else — the activity, the theme,
      the Flutter embedding — is merged in from `src/main` and is the same code.
    -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <!--
      Heart rate (plan 298): Wear OS 5 and earlier ask for BODY_SENSORS; Wear OS 6
      moved heart rate to the health permission group.
    -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Distance (plan 299): the fused location provider, fine and coarse together. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
